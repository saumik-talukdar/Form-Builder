PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27019/form-builder
REDIS_URL=redis://127.0.0.1:6380
JWT_SECRET=change-me-to-a-long-random-string
IP_HASH_SECRET=change-me-to-another-long-random-string
CORS_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the API (set to 1 behind nginx/Cloudflare/Render)
TRUST_PROXY=0
# Per-IP rate limits. Raise them if many respondents share one address (campus or office NAT).
READ_RATE_LIMIT_PER_MIN=120
SUBMIT_RATE_LIMIT_PER_MIN=20
AUTH_RATE_LIMIT_PER_15MIN=30
